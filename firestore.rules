rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "sehgalbalpreet@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Collection: students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == studentId;
      allow update: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection: ingredients
    match /ingredients/{ingredientId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid 
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.category in ["beans", "sugar", "cocoa_butter", "inclusions", "packaging"]
                    && request.resource.data.costPerKg is number;
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.category in ["beans", "sugar", "cocoa_butter", "inclusions", "packaging"]
                    && request.resource.data.costPerKg is number;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection: recipes
    match /recipes/{recipeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.cocoaPercentage is number
                    && request.resource.data.lossFactor is number
                    && request.resource.data.barWeightGrams is number
                    && request.resource.data.packagingCostPerUnit is number;
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.cocoaPercentage is number
                    && request.resource.data.lossFactor is number
                    && request.resource.data.barWeightGrams is number
                    && request.resource.data.packagingCostPerUnit is number;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection: costingRuns
    match /costingRuns/{runId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.recipeName is string
                    && request.resource.data.batchSizeKg is number
                    && request.resource.data.totalCost is number;
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection: fillingRecipes
    match /fillingRecipes/{recipeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.fillingType is string
                    && request.resource.data.targetShelfLife is string
                    && request.resource.data.waterActivity is number
                    && request.resource.data.pH is number;
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.fillingType is string
                    && request.resource.data.targetShelfLife is string
                    && request.resource.data.waterActivity is number
                    && request.resource.data.pH is number;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
